    private static void SetOrientation ()
    {
        Activity mActivity = UnityPlayer.currentActivity;
       
        if (MainActivity.isTablet (mActivity))
        {
            mActivity.setRequestedOrientation (0);
            Log.i("Orientation", ">>>>>>>>>> Orientation changed to SCREEN_ORIENTATION_LANDSCAPE <<<<<<<<<<");
        }
        else 
        {
            mActivity.setRequestedOrientation (1);
            Log.i("Orientation", ">>>>>>>>>> Orientation changed to SCREEN_ORIENTATION_PORTRAIT <<<<<<<<<<");
        }
    }
    
    private static Boolean isTablet (Activity activity)
    {
        try 
        {
            DisplayMetrics displayMetrics = new DisplayMetrics ();
            activity.getWindowManager ().getDefaultDisplay ().getMetrics (displayMetrics);
            double width = (double) displayMetrics.widthPixels;
            double height = (double) displayMetrics.heightPixels;
            double xDensity = (double) displayMetrics.xdpi;
            double yDensity = (double) displayMetrics.ydpi;
            double w = width / xDensity;
            double h = height / yDensity;
            double x = Math.pow (w, 2.0);
            double y = Math.pow (h, 2.0);
            double screenInches = Math.sqrt (x + y);
            
            Log.i("Screen", ">>>>>>>>>> Screen size (inches): " + Double.toString(screenInches) + " <<<<<<<<<<");
            
            if (screenInches > 6.0)
            {
                return true;
            }
            
            return false;
        }
        catch (Exception e) 
        {
            return false;
        }
    }
    
