    static ActionArgs addKeyValuesToArgs(String key , String value , Map<String, Object> jsonTypeData , ActionArgs args,String parentKey) 
    {
    	try 
        {
    		if(value == null)
    			value = "";
    		
	    	Log.i("LeanPlum", "addKeyValuesToArgs  => key : " + key);
			Log.i("LeanPlum", "addKeyValuesToArgs  => value : " + value);
			
	    	String typeValue = "";
			if(jsonTypeData.containsKey(key)) {
				Log.i("LeanPlum", "jsonTypeData  has  key");
				typeValue = jsonTypeData.get(key).toString();
			}
			
			if(typeValue.isEmpty()) {
				if(isStringInt(value)) {
					if(parentKey != null)
						key = parentKey + "." + key;
					Log.i("LeanPlum", "Int  => key : " + key + " value : "+ value);
					args.with(key, Integer.parseInt(value));
				}
				else if(isStringDouble(value)) {
					if(parentKey != null)
						key = parentKey + "." + key;
					Log.i("LeanPlum", "Double  => key : " + key + " value : "+ value);
					args.with(key, Double.parseDouble(value));
				}
				else {
					if(parentKey != null)
						key = parentKey + "." + key;
					Log.i("LeanPlum", "String  => key : " + key + " value : "+ value);
					args.with(key,value);
				}
			}
			else {
				if(typeValue.equals("Action")) {
					if(parentKey != null)
						key = parentKey + "." + key;
					Log.i("LeanPlum", "Action  => key : " + key + " value : "+ value);
					args.withAction(key, value);
				}
				else if(typeValue.equals("Bool")) {
					if(parentKey != null)
						key = parentKey + "." + key;
					Log.i("LeanPlum", "Bool  => key : " + key + " value : "+ value);
					args.with(key, Boolean.getBoolean(value));
				}
				else if(typeValue.equals("File")) {
					if(parentKey != null)
						key = parentKey + "." + key;
					Log.i("LeanPlum", "File => key : " + key + " value : "+ value);
					args.withFile(key, value);
				}
				else if(typeValue.equals("Color")) {
					if(parentKey != null)
						key = parentKey + "." + key;
					Log.i("LeanPlum", "Color  => key : " + key + " value : "+ hex2decimal(value));
					args.withColor(key, hex2decimal(value));
				}
				else {
					if(parentKey != null)
						key = parentKey + "." + key;
					Log.i("LeanPlum", "defalult string => key : " + key + " value : "+ value);
					args.with(key, value);
				}
			}
			return args;
        }
    	catch (Exception e) 
        {
        	Log.i("LeanPlum", "checkJSONandAddToArgs exception : " + e.getMessage());
        }
    	return null;
    }
    
    static boolean isStringInt(String s)
    {
        try
        {
            Integer.parseInt(s);
            return true;
        } catch (NumberFormatException ex)
        {
            return false;
        }
    }
    
    static boolean isStringDouble(String s)
    {
        try
        {
            Double.parseDouble(s);
            return true;
        } catch (NumberFormatException ex)
        {
            return false;
        }
    }
    
    static int hex2decimal(String s) {
        String digits = "0123456789ABCDEF";
        s =  s.toUpperCase(Locale.getDefault());
        int val = 0;
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            int d = digits.indexOf(c);
            val = 16*val + d;
        }
        return val;
    }
    
    static ActionArgs checkJSONandAddToArgs(Map<String, Object> jsonData , Map<String, Object> jsonTypeData , ActionArgs args) {
    	try 
        {
	    	if(args == null)
	    		args = new ActionArgs();
			for (String key : jsonData.keySet()) {
				String value = jsonData.get(key).toString();
				
				Log.i("LeanPlum", "checkJSONandAddToArgs  => key : " + key);
				Log.i("LeanPlum", "checkJSONandAddToArgs  => value : " + value);
				
				if(value.contains("=") && value.contains("{") && value.contains("}")) {
					String tempValue = value.substring(value.indexOf("{") + 1);
					tempValue = tempValue.substring(0,tempValue.length()-1);
					Log.i("LeanPlum", "checkJSONandAddToArgs  => value will Splitt : " + tempValue);
					String[] values = tempValue.split(",");
					for (String word : values) {
						String[] valuesIn = word.split("=");
						String valueIn = "";
						if(valuesIn.length > 1)
							valueIn = valuesIn[1].trim();
						args = addKeyValuesToArgs(valuesIn[0].trim(),valueIn,jsonTypeData,args,key);
					}
				}
				else {
					Log.i("LeanPlum", "checkJSONandAddToArgs  => value directly added : " + value);
					args = addKeyValuesToArgs(key,value,jsonTypeData,args,null);
				}
			}
			return args;
        }
    	catch (Exception e) 
        {
        	Log.i("LeanPlum", "checkJSONandAddToArgs exception : " + e.getMessage());
        }
    	return null;
    }
    
    static String decodeResponce(ActionContext arg0, Map<String, Object> jsonData, Map<String, Object> jsonTypeData) {
    	try 
        {
    	
    		 Map<String, Object> tempResponse = jsonData;
    		 for (String key : jsonData.keySet()) {
    			 String typeValue = "";
    			 if(jsonTypeData.containsKey(key)) {
    				Log.i("LeanPlum", "Responce jsonTypeData  has  key");
    				typeValue = jsonTypeData.get(key).toString();
    			}
    			String value = jsonData.get(key).toString();
    			if(typeValue.isEmpty()) {
    				if(isStringInt(value)) {
    					//parent key
    					Log.i("LeanPlum", "Responce bfr Int  => key : " + key + " value : "+ value);
    					tempResponse.put(key, arg0.numberNamed(key).intValue());
    					Log.i("LeanPlum", "Responce Int  => key : " + key + " value : "+ arg0.numberNamed(key));
    				}
    				else if(isStringDouble(value)) {
    					//parent key
    					Log.i("LeanPlum", "Responce bfr Double  => key : " + key + " value : "+ value);
    					tempResponse.put(key, arg0.numberNamed(key).doubleValue());
    					Log.i("LeanPlum", "Responce Double  => key : " + key + " value : "+ arg0.numberNamed(key));
    				}
    				else {
    					//parent key
    					Log.i("LeanPlum", "Responce bfr String  => key : " + key + " value : "+ value);
    					tempResponse.put(key, arg0.stringNamed(key));
    					Log.i("LeanPlum", "Responce String  => key : " + key + " value : "+ arg0.stringNamed(key));
    				}
    			}
    			else {
    				if(typeValue.equals("Action")) {
    					//parent key
    					Log.i("LeanPlum", "Responce bfr Action  => key : " + key + " value : "+ value);
    					tempResponse.put(key, arg0.objectNamed(key));
    					Log.i("LeanPlum", "Responce Action  => key : " + key + " value : "+ arg0.objectNamed(key));
    				}
    				else if(typeValue.equals("Bool")) {
    					//parent key
    					Log.i("LeanPlum", "Responce bfr Bool  => key : " + key + " value : "+ value);
    					tempResponse.put(key, arg0.booleanNamed(key));
    					Log.i("LeanPlum", "Responce Bool  => key : " + key + " value : "+ arg0.booleanNamed(key));
    				}
    				else if(typeValue.equals("File")) {
    					//parent key
    					Log.i("LeanPlum", "Responce bfr File => key : " + key + " value : "+ value);
    					tempResponse.put(key, arg0.objectNamed(key));
    					Log.i("LeanPlum", "Responce File  => key : " + key + " value : "+ arg0.objectNamed(key));
    				}
    				else if(typeValue.equals("Color")) {
    					//parent key
    					String color = Integer.toHexString(arg0.numberNamed(key).intValue());
    					Log.i("LeanPlum", "Responce bfr Color  => key : " + key + " value : "+ color);
    					tempResponse.put(key, arg0.objectNamed(key));
    					Log.i("LeanPlum", "Responce Color  => key : " + key + " value : "+ color);
    				}
    				else {
    					//parent key
    					Log.i("LeanPlum", "Responce bfr defalult string => key : " + key + " value : "+ value);
    					tempResponse.put(key, arg0.stringNamed(key));
    					Log.i("LeanPlum", "Responce defalult string  => key : " + key + " value : "+ arg0.stringNamed(key));
    				}
    			}
    		 }
    		tempResponse.put("MW_IAM_Name", arg0.actionName());
    		String result = JsonConverter.toJson(tempResponse);
    		Log.i("LeanPlum", "decodeResponce result : " + result);
    		return result;
        }
    	catch (Exception e) 
        {
        	Log.i("LeanPlum", "decodeResponce exception : " + e.getMessage());
        }
    	return null;
    }
    
    
    public static void InitializeIAMTemplate(String name, String data, String typedict, int kind ) 
    {
    	try 
        {
    		Log.i("LeanPlum", "InitializeIAMTemplate => name : " + name + " data : " + data + " typedict : " + typedict + " kind : " + kind);
    		
    		final Map<String, Object> jsonDataStatic = JsonConverter.fromJson(data);
    		final Map<String, Object> jsonTypeDataStatic = JsonConverter.fromJson(typedict);
    		
    		ActionArgs args = checkJSONandAddToArgs(jsonDataStatic,jsonTypeDataStatic,null);
    		
    		ActionCallback responder = new ActionCallback() {
				public boolean onResponse(ActionContext arg0) {
					String actName = arg0.actionName();
					Log.i("LeanPlum", "InitializeIAMTemplate responce => actName : " + actName);
					String decodedJson = decodeResponce(arg0,jsonDataStatic,jsonTypeDataStatic);
					Log.i("LeanPlum", "InitializeIAMTemplate decodedJson => : " + decodedJson);
					string part1 = decodedJson.substring(0, (decodedJson.length() / 2));
					
					
					UnityPlayer.UnitySendMessage("MWLeanplumManager", "MessageArrived", decodedJson);
					return true;
				}
			};
			
    		Leanplum.defineAction(name, kind, args, responder);
        }
        catch (Exception e) 
        {
        	Log.i("LeanPlum", "InitializeIAMTemplate exception : " + e.getMessage());
        }
    }
    
