    // Device Sound Test Region  // Govinda Rajulu Yella Feb-10-2016
    public static void checkAudioIsPlaying(String gameObject,String methodName) 
    {
    	try 
        {	
    		CharSequence cs1 = "playbackservice";
	    	CharSequence cs2 = "mediaplaybackservice";
	    	CharSequence cs3 = "musicplaybackservice";
	    	ActivityManager am= (ActivityManager) UnityPlayer.currentActivity.getSystemService(Context.ACTIVITY_SERVICE);   
	    	List<RunningServiceInfo> serviceInfo = am.getRunningServices(75);
	    	if(gameObject.equals("log"))
	    		Log.i("Audio", ">>>>>>>>>> Service List Goes here <<<<<<<<<<");
	    	String tempServiceName = "";
	    	RunningServiceInfo rti;
	    	for (int j = 0; j < serviceInfo.size(); j++) {
	    		rti = serviceInfo.get(j); 
	    		tempServiceName = rti.service.getClassName().toLowerCase(Locale.getDefault());
	    		if(tempServiceName.contains(cs1) || tempServiceName.contains(cs2) || tempServiceName.contains(cs3) ) {
	    			if(rti.flags == 3 || rti.foreground) {
	    				  UnityPlayer.UnitySendMessage(gameObject,methodName,"true");
	    				  if(!(gameObject.equals("log")))
	    					  return;
	    			}			
	    		}
	    		if(gameObject.equals("log")) {
	    			Log.i("Audio", "Pname : " + rti.service.getPackageName());
	    			Log.i("Audio", "Cname : " + rti.service.getClassName());
	    			Log.i("Audio", tempServiceName);
	    			Log.i("Audio", "flag : " + rti.flags);
	    			Log.i("Audio", "foreGround : " + rti.foreground);
    			}
			}    	
	    	UnityPlayer.UnitySendMessage(gameObject,methodName,"false");
	    	return;
        }
    	catch (Exception e) 
        {
    		UnityPlayer.UnitySendMessage(gameObject,methodName,"false");
        }
	}
