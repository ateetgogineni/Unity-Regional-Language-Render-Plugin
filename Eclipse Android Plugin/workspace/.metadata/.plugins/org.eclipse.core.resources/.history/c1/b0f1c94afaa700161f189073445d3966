    public static void getCountryName() {
    	String country = UnityPlayer.currentActivity.getResources().getConfiguration().locale.getDisplayCountry();
    	Log.i("country", ">>>>>>>>>> countryName <<<<<<<<<< : " + country);
    	UnityPlayer.UnitySendMessage("SoundManager","CountryCode",country);
    	Locale templocale = Locale.getDefault();
    	Currency currency = Currency.getInstance(templocale);
    	String currencyCode = currency.getDisplayName(templocale);
    	Log.i("country", ">>>>>>>>>> currencyCode <<<<<<<<<< : " + currencyCode);
    	UnityPlayer.UnitySendMessage("SoundManager","CurrencyCode",currencyCode);
    }
    
