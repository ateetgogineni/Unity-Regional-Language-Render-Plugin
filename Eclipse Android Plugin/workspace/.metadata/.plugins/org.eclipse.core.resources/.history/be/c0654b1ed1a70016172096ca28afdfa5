    private static void SetOrientation ()
    {
        Activity mActivity = UnityPlayer.currentActivity;
       
        if (MainActivity.isTablet (mActivity))
        {
            mActivity.setRequestedOrientation (0);
            Log.i("Birla", ">>>>>>>>>> Orientation changed to SCREEN_ORIENTATION_LANDSCAPE <<<<<<<<<<");
        }
        else 
        {
            mActivity.setRequestedOrientation (1);
            Log.i("Birla", ">>>>>>>>>> Orientation changed to SCREEN_ORIENTATION_PORTRAIT <<<<<<<<<<");
        }
    }
    
    private static Boolean isTablet (Activity activity)
    {
        try 
        {
            DisplayMetrics displayMetrics = new DisplayMetrics ();
            activity.getWindowManager ().getDefaultDisplay ().getMetrics (displayMetrics);
            double width = (double) displayMetrics.widthPixels;
            double height = (double) displayMetrics.heightPixels;
            double xDensity = (double) displayMetrics.xdpi;
            double yDensity = (double) displayMetrics.ydpi;
            double w = width / xDensity;
            double h = height / yDensity;
            double x = Math.pow (w, 2.0);
            double y = Math.pow (h, 2.0);
            double screenInches = Math.sqrt (x + y);
            
            Log.i("Birla", ">>>>>>>>>> Screen size (inches): " + Double.toString(screenInches) + " <<<<<<<<<<");
            
            if (screenInches > 6.0)
            {
                return true;
            }
            
            return false;
        }
        catch (Exception e) 
        {
            return false;
        }
    }
    
 // Get Country Name  // Govinda Rajulu Yella Apr-14-2016
    public static void getCountryName() {
    	String country = UnityPlayer.currentActivity.getResources().getConfiguration().locale.getDisplayCountry();
    	Log.i("country", ">>>>>>>>>> countryName <<<<<<<<<< : " + country);
    	UnityPlayer.UnitySendMessage("SoundManager","CountryCode",country);
    	Locale templocale = Locale.getDefault();
    	Currency currency = Currency.getInstance(templocale);
    	String currencyCode = currency.getDisplayName(templocale);
    	Log.i("country", ">>>>>>>>>> currencyCode <<<<<<<<<< : " + currencyCode);
    	UnityPlayer.UnitySendMessage("SoundManager","CurrencyCode",currencyCode);
    }
    
